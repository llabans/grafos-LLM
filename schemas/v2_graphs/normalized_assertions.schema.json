{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2_graphs/normalized_assertions.schema.json",
  "title": "Normalized assertion record",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_id", "canonical_gpc_id", "source_variant_id", "source_object_id", "source_path", "source_locator", "raw_text", "normalized_text", "version_status", "supersedes_assertion_ids", "resolution_basis", "review_status"],
  "properties": {
    "assertion_id": {"type": "string", "minLength": 1},
    "canonical_gpc_id": {"type": "string", "minLength": 1},
    "source_variant_id": {"type": "string", "minLength": 1},
    "source_object_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_locator": {"$ref": "#/$defs/sourceLocator"},
    "raw_text": {"type": "string", "minLength": 1},
    "normalized_text": {"type": "string", "minLength": 1},
    "version_status": {"enum": ["current", "superseded", "conflicting", "pending_human"]},
    "supersedes_assertion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resolution_basis": {"enum": ["canonical", "errata", "human_adjudication", "unresolved"]},
    "review_status": {"$ref": "#/$defs/reviewStatus"}
  },
  "$defs": {
    "reviewStatus": {"enum": ["pending_human", "approved_by_human", "rejected"]},
    "sourceLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["section", "page", "table_id", "flow_id", "recommendation_id"],
      "properties": {
        "section": {"type": ["string", "null"]}, "page": {"type": ["integer", "null"], "minimum": 1},
        "table_id": {"type": ["string", "null"]}, "flow_id": {"type": ["string", "null"]},
        "recommendation_id": {"type": ["string", "null"]}
      }
    }
  }
}
