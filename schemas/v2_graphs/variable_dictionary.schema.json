{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2_graphs/variable_dictionary.schema.json",
  "title": "Clinical variable definition",
  "type": "object", "additionalProperties": false,
  "required": ["variable_id", "canonical_label", "value_type", "allowed_domain", "allowed_units", "decision_partitions", "dependent_predicate_ids", "incompatibility_rules", "requires_human_review", "source_assertion_ids", "review_status"],
  "properties": {
    "variable_id": {"type": "string", "minLength": 1}, "canonical_label": {"type": "string", "minLength": 1},
    "value_type": {"enum": ["boolean", "integer", "number", "categorical", "string", "date"]},
    "allowed_domain": {"type": "array", "items": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "allowed_units": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "decision_partitions": {"type": "array", "items": {"$ref": "#/$defs/partition"}},
    "dependent_predicate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "incompatibility_rules": {"type": "array", "items": {"$ref": "#/$defs/incompatibility"}},
    "requires_human_review": {"type": "boolean"},
    "source_assertion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review_status": {"enum": ["pending_human", "approved_by_human", "rejected"]}
  },
  "$defs": {
    "partition": {"type": "object", "additionalProperties": false, "required": ["partition_id", "expression", "review_status"], "properties": {"partition_id": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "review_status": {"enum": ["pending_human", "approved_by_human", "rejected"]}}},
    "incompatibility": {"type": "object", "additionalProperties": false, "required": ["rule_id", "description", "review_status"], "properties": {"rule_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "review_status": {"enum": ["pending_human", "approved_by_human", "rejected"]}}}
  }
}
