{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2_graphs/executable_rules.schema.json",
  "title": "Executable rule with explicit missing-data behavior",
  "type": "object", "additionalProperties": false,
  "required": ["rule_id", "rule_type", "expression", "input_variable_ids", "output", "source_atom_ids", "missing_data_behavior", "review_status"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "rule_type": {"enum": ["eligibility", "exclusion", "branch", "action", "prohibited_action", "abstention", "information_request", "scope", "pending_human"]},
    "expression": {"$ref": "#/$defs/expression"},
    "input_variable_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output": {"$ref": "#/$defs/output"},
    "source_atom_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "missing_data_behavior": {"enum": ["request_information", "abstain", "propagate_unknown", "not_applicable", "pending_human"]},
    "review_status": {"enum": ["pending_human", "approved_by_human", "rejected"]}
  },
  "$defs": {
    "expression": {"type": "object", "additionalProperties": false, "required": ["operator", "arguments"], "properties": {"operator": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "and", "or", "not", "known", "unknown", "conflicting", "pending_human"]}, "arguments": {"type": "array", "items": {"type": ["string", "number", "integer", "boolean", "null"]}}}},
    "output": {"type": "object", "additionalProperties": false, "properties": {"status": {"enum": ["true", "false", "unknown", "conflicting", "pending_human"]}, "route_id": {"type": "string"}, "action_concept_ids": {"type": "array", "items": {"type": "string"}}, "request_variable_ids": {"type": "array", "items": {"type": "string"}}, "abstain": {"type": "boolean"}}}
  }
}
